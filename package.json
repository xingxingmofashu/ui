{
  "name": "@xingxingmofashu/ui",
  "version": "0.1.1",
  "description": "Accessible React components with a Liquid Glass visual style for React 19 and Tailwind CSS 4.",
  "license": "MIT",
  "author": "xingxingmofashu",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "style": "./dist/index.css",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.mjs",
      "default": "./dist/components/*.mjs"
    },
    "./composables/*": {
      "types": "./dist/composables/*.d.ts",
      "import": "./dist/composables/*.mjs",
      "default": "./dist/composables/*.mjs"
    },
    "./theme/*": {
      "types": "./dist/theme/*.d.ts",
      "import": "./dist/theme/*.mjs",
      "default": "./dist/theme/*.mjs"
    },
    "./index.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "style": "./dist/index.css",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingxingmofashu/ui.git"
  },
  "homepage": "https://github.com/xingxingmofashu/ui",
  "bugs": {
    "url": "https://github.com/xingxingmofashu/ui/issues"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "tailwindcss",
    "liquid-glass",
    "base-ui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "unbuild",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "docs:dev": "pnpm --filter @xingxingmofashu/docs dev",
    "docs:build": "pnpm --filter @xingxingmofashu/docs build",
    "docs:typecheck": "pnpm --filter @xingxingmofashu/docs typecheck",
    "playground:dev": "pnpm --filter @xingxingmofashu/playground dev",
    "playground:build": "pnpm --filter @xingxingmofashu/playground build",
    "playground:typecheck": "pnpm --filter @xingxingmofashu/playground typecheck",
    "prepare": "husky",
    "prepublishOnly": "pnpm lint && pnpm build && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "cn": "catalog:",
    "tailwind-variants": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/node": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "husky": "catalog:",
    "jsdom": "catalog:",
    "oxlint": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": ">=4.0.0"
  }
}
